# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth (optional; used if switching to @react-oauth/google for web)
# EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=

# -----------------------------------------------------------------------------
# DEVELOPER-ONLY HELPERS — DO NOT SET IN ANY HANDOVER OR RELEASE BUILD
# -----------------------------------------------------------------------------
# Expo bakes EXPO_PUBLIC_* values into the JS bundle at build time. Anything set
# here ships to the client and can be extracted from the bundle. Leave the
# entries below COMMENTED OUT (or absent) for any build that goes to the client.
#
# Demo / preview mode: replaces real Supabase calls with seeded fakes from
# src/lib/demo-mode.ts. Code also requires __DEV__, so release builds ignore
# this flag — but keep it false/absent so dev-client builds aren't accidentally
# in demo mode either. Never share recordings as "live demos" if this is true.
# EXPO_PUBLIC_DEMO_MODE=false
#
# Dev Quick Login: a one-tap login button that signs in with the email/password
# below. Code also requires __DEV__, so release builds ignore the button — but
# the credentials still ship in the bundle if these vars are set. Leave UNSET
# in any handover env file.
# EXPO_PUBLIC_DEV_SIGNIN_EMAIL=
# EXPO_PUBLIC_DEV_SIGNIN_PASSWORD=
